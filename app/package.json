{
  "name": "firewall-blocker",
  "version": "2.1.1",
  "description": "Block/unblock Windows Firewall rules for .exe files in a folder",
  "private": true,
  "type": "module",
  "author": "IdraDev",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "web:dev": "vite",
    "web:build": "vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "dist": "tauri build && bun -e \"const fs=require('fs');const v=require('./package.json').version;fs.mkdirSync('release',{recursive:true});fs.copyFileSync('src-tauri/target/release/FirewallBlocker.exe','release/FirewallBlocker-'+v+'-portable.exe');fs.copyFileSync('src-tauri/target/release/bundle/nsis/Firewall Blocker_'+v+'_x64-setup.exe','release/FirewallBlocker-'+v+'-setup.exe')\""
  },
  "dependencies": {
    "@fluentui/react-components": "^9.72.0",
    "@fluentui/react-icons": "^2.0.300",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
