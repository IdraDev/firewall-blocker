{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firewall Blocker",
  "mainBinaryName": "FirewallBlocker",
  "version": "../package.json",
  "identifier": "net.idragraphics.firewallblocker",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Firewall Blocker",
        "width": 1100,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://icon.localhost icon:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "IdraDev",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
